{
  "name": "my-turborepo",
  "private": true,
  "pnpm": {
    "overrides": {
      "@swc/helpers": ">=0.5.17"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@vitejs/plugin-react-swc>vite": "7.3.1",
        "@tailwindcss/vite>vite": "7.3.1"
      }
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
