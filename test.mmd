        string mapping_id PK
        string source_template_id FK
        string target_template_id FK
    }
    MAPPING_OF_BOXES {
        string box_to_box_map_id PK
        string mapping_id FK
        string source_boxes_id FK
        string target_boxes_id FK
    }
