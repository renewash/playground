        string document_id PK
        string name
        string file_path
    }
    TEMPLATES {
        string template_id PK
        string document_id FK
    }
    BOXES {
        string boxes_id PK
        int page_number
        float x
        float y
        float width
        float height
        string template_id fk
    }
